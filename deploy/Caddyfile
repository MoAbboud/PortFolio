# One block per public subdomain. Caddy fetches and renews the HTTPS certificates itself;
# each name only needs a DNS A record pointing at this server.
#
# The root domain and www are NOT here: they point at GitHub Pages, which serves the
# static site and issues its own certificate.

{
	email {$ACME_EMAIL}
}

mailman.{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy mailman:8000
}

