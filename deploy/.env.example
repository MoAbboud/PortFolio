# Copy to deploy/.env on the server and fill the values. deploy/.env is git-ignored.
#
# Passwords go inside database URLs, so use letters and digits only. On the server:
#   openssl rand -hex 24
# gives one. Run it once per password.

# The domain you bought, without www or https://
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Required: the default set (Caddy, Postgres, mailman).
POSTGRES_PASSWORD=
MAILMAN_DB_PASSWORD=
# mailman's upload and review endpoints ask for this key. Keep it private.
MAILMAN_API_KEY=

# Optional: only for --profile herder. Leave blank otherwise.
HERDER_DB_PASSWORD=

# Optional: only for --profile whereyago. Leave blank otherwise.
WHEREYAGO_DB_PASSWORD=
#   openssl rand -hex 32
WHEREYAGO_SECRET_KEY=
