{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "venue.schema.json",
  "title": "Venue",
  "description": "One restaurant or bar's content. Every look reads this and only this (requirements/04-data-model.md).",
  "type": "object",
  "required": ["slug", "name", "kind", "language", "currency", "mode", "style", "locations", "menus"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["cocktail-bar", "bar", "restaurant"] },
    "tagline": { "type": "string" },
    "about": { "type": "string" },
    "cuisine": { "type": "string" },
    "price_range": { "type": "integer", "minimum": 1, "maximum": 4 },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "mode": { "enum": ["preview", "live"] },
    "phone_orders": { "type": "boolean", "description": "Takes orders by phone. The call button reads Call to order." },
    "order_url": { "type": "string", "pattern": "^https://", "description": "The venue's own ordering page. The site links to it; it never takes an order itself." },
    "private_events": {
      "type": "object",
      "description": "An event inquiry for bars (P47): date, guests, budget - sent from the guest's own email app to this address.",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "pattern": "^[^@ ]+@[^@ ]+[.][^@ ]+$" },
        "note": { "type": "string" }
      }
    },
    "reserve_url": { "type": "string", "pattern": "^https://", "description": "The venue's booking page (Resy, OpenTable or its own). The site links to it." },
    "style": {
      "type": "object",
      "required": ["look"],
      "additionalProperties": false,
      "properties": {
        "look": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "palette": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "One of the palettes the look offers (its look.json). Ignored by looks without palettes." },
        "color_primary": { "$ref": "#/definitions/color" },
        "color_accent": { "$ref": "#/definitions/color" },
        "logo": { "type": "string" },
        "logo_light": { "type": "string" }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/location" }
    },
    "menus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sections"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "served": { "type": "string" },
          "note": { "type": "string" },
          "until": { "$ref": "#/definitions/date", "description": "Last day of a seasonal menu. The page stops showing it after this date, and the content check fails until it is updated." },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "items"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "note": { "type": "string" },
                "display": { "enum": ["feature", "tiles", "list"], "description": "How a look sets the section. Left out, the look decides." },
                "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "date"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "date": { "$ref": "#/definitions/date" },
          "starts": { "$ref": "#/definitions/time" },
          "repeats": { "enum": ["weekly", "monthly"] },
          "description": { "type": "string" },
          "icon": { "enum": ["mask"] },
          "photo": { "type": "string" }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "starts": { "$ref": "#/definitions/date" },
          "ends": { "$ref": "#/definitions/date" }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "alt", "use"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "alt": { "type": "string", "minLength": 1 },
          "use": { "enum": ["hero", "gallery", "drink", "dish", "interior", "bar", "team", "event"] }
        }
      }
    },
    "social": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "url"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["instagram", "facebook", "tiktok", "google", "yelp", "other"] },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  },
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "range": {
      "type": "object",
      "required": ["opens", "closes"],
      "additionalProperties": false,
      "properties": { "opens": { "$ref": "#/definitions/time" }, "closes": { "$ref": "#/definitions/time" } }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mon": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "tue": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "wed": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "thu": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "fri": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "sat": { "type": "array", "items": { "$ref": "#/definitions/range" } },
        "sun": { "type": "array", "items": { "$ref": "#/definitions/range" } }
      }
    },
    "window": {
      "type": "object",
      "required": ["starts", "ends"],
      "additionalProperties": false,
      "properties": { "starts": { "$ref": "#/definitions/time" }, "ends": { "$ref": "#/definitions/time" } }
    },
    "location": {
      "type": "object",
      "required": ["street", "city", "country", "time_zone", "hours"],
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "postal_code": { "type": "string" },
        "country": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "phone": { "type": "string" },
        "time_zone": { "type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_+-]+)+$" },
        "hours": { "$ref": "#/definitions/week" },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from"],
            "additionalProperties": false,
            "properties": {
              "from": { "$ref": "#/definitions/date" },
              "to": { "$ref": "#/definitions/date" },
              "closed": { "type": "boolean" },
              "hours": { "type": "array", "items": { "$ref": "#/definitions/range" } },
              "note": { "type": "string" }
            },
            "oneOf": [
              { "required": ["closed"], "properties": { "closed": { "const": true } } },
              { "required": ["hours"] }
            ]
          }
        },
        "happy_hour": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mon": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "tue": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "wed": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "thu": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "fri": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "sat": { "type": "array", "items": { "$ref": "#/definitions/window" } },
            "sun": { "type": "array", "items": { "$ref": "#/definitions/window" } }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "ingredients": { "type": "array", "items": { "type": "string" } },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["vegetarian", "vegan", "gluten-free", "dairy-free", "nut-free", "spicy", "zero-proof", "new", "house-favourite", "seasonal"] }
        },
        "prices": {
          "type": "array",
          "description": "One amount for most items, several for sizes or pours, none for market price.",
          "items": {
            "type": "object",
            "required": ["amount"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "amount": { "type": "number", "minimum": 0 } }
          }
        },
        "happy_hour_price": { "type": "number", "minimum": 0 },
        "photo": { "type": "string" },
        "sold_out": { "type": "boolean" },
        "art": { "$ref": "#/definitions/art" }
      }
    },
    "art": {
      "type": "object",
      "description": "A drawn drink, for looks that draw them: a glass, a liquid, ice, a garnish and extras.",
      "required": ["glass"],
      "additionalProperties": false,
      "properties": {
        "glass": { "enum": ["rocks", "martini", "collins", "coupe"] },
        "liquid": { "enum": ["amber", "red", "clear", "hibiscus", "ink", "honey", "brine", "pale"] },
        "ice": { "type": "boolean" },
        "garnish": { "$ref": "#/definitions/garnish" },
        "extras": { "type": "array", "uniqueItems": true, "items": { "enum": ["smoke", "bubbles", "twinkle", "quill", "lantern", "fireworks", "crown"] } },
        "variants": {
          "type": "object",
          "description": "Keyed by a price label: what changes when the guest picks that version.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "garnish": { "$ref": "#/definitions/garnish" }, "liquid": { "enum": ["amber", "red", "clear", "hibiscus", "ink", "honey", "brine", "pale"] } }
          }
        }
      }
    },
    "garnish": { "enum": ["none", "orange-peel", "lemon-peel", "orange-wheel", "lemon-wheel", "lime-wheel", "olive", "orange-coin"] }
  }
}
