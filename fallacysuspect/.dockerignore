# Keep the build context (and image) small and secret-free.
.git
.gitignore
README.md
argument.txt
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.env
*.db
*.db-wal
*.db-shm
.DS_Store
# Only fallacy_warn/ is copied into the image, but without these the whole folder -
# 1.4 GB of model sets, the training data and notebooks - is sent to the builder first.
models/
model v2/
data/
notebooks/
scripts/
requirements/
*.log
