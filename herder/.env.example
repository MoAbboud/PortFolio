# Copy to .env and adjust. .env is gitignored.
# In PowerShell:  Copy-Item .env.example .env
#
# There is NO provider API key in this project and there never will be. Every model
# herder runs is a file on disk. See requirements/00-plan.md.

# Overridden by docker-compose for the containerised run.
DATABASE_URL=postgresql+asyncpg://herder:herder@localhost:5432/herder

# Which extractor runs: heuristic (default), local, trained.
# An unknown value is an error rather than a silent default - a typo that quietly
# downgraded extraction would make every number after it a lie.
HERDER_EXTRACTOR=heuristic

# Where the weights live. Gitignored, fetched on purpose, never at import time.
HERDER_MODEL_DIR=./models

# The local extractor talks to Ollama. Install it from https://ollama.com and
#     ollama pull qwen2.5:3b
# From inside Docker the host is http://host.docker.internal:11434.
HERDER_OLLAMA_URL=http://localhost:11434
HERDER_LLM_MODEL=qwen2.5:3b
# Ollama's own default is 5 minutes, which is wrong here: loading the model costs about
# 2 minutes and one derive costs about 5 seconds.
HERDER_LLM_KEEP_ALIVE=30m

# The loop. Every one of these is an open question in requirements/00-plan.md with a
# stage attached. These are starting points, not answers.
HERDER_CHUNK_TOKENS=6000
HERDER_DERIVE_THRESHOLD_TOKENS=2000
HERDER_BRIEF_BUDGET_TOKENS=3000
HERDER_SESSION_TAIL_TOKENS=1200
HERDER_SIMILARITY_THRESHOLD=0.86
HERDER_PROBE_COUNT=6
