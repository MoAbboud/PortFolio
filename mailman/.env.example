# Copy to .env and fill in. .env is gitignored.
# In PowerShell:  Copy-Item .env.example .env

# Provider credentials. Not needed until stage 2.
ANTHROPIC_API_KEY=

# Shared secret for the API. Not enforced until stage 6.
MAILMAN_API_KEY=

# Which extractor runs: hybrid (default), heuristic, trained, anthropic.
# You do not need to set this. "hybrid" uses the trained model for buyer_name when
# ./models/extractor holds weights and behaves exactly as "heuristic" when it does not,
# so it is safe everywhere and there is nothing to switch on.
MAILMAN_EXTRACTOR=hybrid

# Where the trained weights live, if you have unzipped any. 250MB, gitignored.
MAILMAN_MODEL_DIR=./models/extractor

# Overridden by docker-compose for the containerised run.
DATABASE_URL=postgresql+psycopg://mailman:mailman@localhost:5432/mailman
STORAGE_ROOT=./data/documents
