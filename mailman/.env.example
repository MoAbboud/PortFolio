# Copy to .env and fill in. .env is gitignored.
# In PowerShell:  Copy-Item .env.example .env

# Provider credentials. Not needed until stage 2.
ANTHROPIC_API_KEY=

# Shared secret for the API. Not enforced until stage 6.
MAILMAN_API_KEY=

# Overridden by docker-compose for the containerised run.
DATABASE_URL=postgresql+psycopg://mailman:mailman@localhost:5432/mailman
STORAGE_ROOT=./data/documents
